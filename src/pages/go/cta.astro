---
/**
 * CTA の中間ページ。
 *
 * なぜ挟むか: このページの訪問数＝CTAクリック数になる。
 * ボタンに JS を足さなくてもクリック率が取れる（GA4 のページ閲覧数で読める・御堂ゲート §5）。
 *
 * 行き先は X のプロフィール（2026-10-12 オーナー回答: 主は X の DM。メールも併記する）。
 * 2026-10-13 からトップはこのページを経由せず X へ直接リンクしている。古いリンクの受け皿として残す。
 * DM 作成画面への直リンクは数値の user ID が要るので使わず、
 * 「プロフィールのメッセージボタンから」と書いてから移る。
 */
import Base from '../../layouts/Base.astro';
import { 相談先URL, 相談の案内, ハンドル, メール, メールリンク, メールの案内 } from '../../config/サイト設定';

const 行き先 = 相談先URL;
---

<Base
  title="X のプロフィールへ移動します"
  description="X のプロフィールへ移動します。連絡は X の DM かメールでとれます。"
  noindex={true}
>
  <div class="wrap doc" style="text-align:center;max-width:32rem">
    <h1>X のプロフィールへ移動します</h1>
    <p>
      X（{ハンドル}）のプロフィールを開きます。<br />
      {相談の案内}。
    </p>
    <p class="small">
      自動で切り替わらない場合は、下のボタンを押してください。
    </p>
    <div class="btn-row" style="justify-content:center">
      <a class="btn" href={行き先} id="go" rel="noopener">X のプロフィールを開く →</a>
    </div>
    <p class="small">
      {メールの案内}: <a class="mail" href={メールリンク} data-ga="cta_click" data-item="mail-go-cta">{メール}</a>
    </p>
    <a class="back-link" href="/">← トップに戻る</a>
  </div>

  {/*
    移動は meta refresh の3秒だけにした。すぐ飛ばすと「メッセージボタンから」の一文を読む前に
    X に移ってしまうため。JS はクリック計測のイベントを送るだけに使う（3秒あれば送り終わる）。
  */}
  <meta http-equiv="refresh" content={`3;url=${行き先}`} slot="head" />
  <script is:inline>
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'cta_click', { item: 'go-cta-page', page_path: location.pathname });
    }
  </script>
</Base>
