---
/**
 * トップ。2026-10-13 にオーナー指示＋御堂の再設計で作り替えた。
 *
 * オーナーの言葉で「経歴を書いているだけ」のサイト（案件を受けるためのページではない・2026-10-13）。
 * 主語は営業・プランナー。AI は「自分でも作って使っている」という裏付けに回す。
 * 受託や営業代行を呼びかける文言は置かない。「今できること」は能力の説明として書く。
 * 連絡先は一番下に事実として置くだけ（ヘッダー・ヒーローに CTA を置かない）。
 * 静岡県の広報戦略アドバイザー就任は、数字の枠に入れず、実績節の下の注記として控えめに1か所だけ出す。
 *
 * 構成（上から）:
 *   1 ヒーロー（プロフィールの要約）→ 2 実績（数字4つ＋就任）→ 3 経歴 → 4 今できること
 *   → 5 AI は自分で作っている（裏付け）→ 6 つくったもの への導線 → 7 連絡先
 * 個人で作って動かしている物は「個人で」と書き、受託の実績とも勤務先の業務とも混ぜない。
 */
import Base from '../layouts/Base.astro';
import {
  氏名,
  サイト名,
  ハンドル,
  Xリンク,
  メール,
  メールリンク,
} from '../config/サイト設定';
import { 公開済み一覧, 開発中一覧 } from '../config/実績';
import { 経歴, 実績の数字, 就任 } from '../config/経歴';
import { 今できること, 実例, 実例の時点 } from '../config/本文';

const 毎朝のジョブ = 実例[0];
const アプリ数 = 公開済み一覧.filter((x) => x.種別.startsWith('iOS')).length;
const 開発中 = 開発中一覧[0];
---

<Base
  title={サイト名}
  description="営業とプランニングで、売れる形をつくる。求人広告の法人営業とインフルエンサー施策の営業を経て、株式会社REECH で美容・食品メーカーや行政の SNS 施策・PR を担当。AI も自分で作って、毎日の仕事に使っています。"
>
  {/* ── 1 ヒーロー（プロフィールの要約） ──────────── */}
  <section class="wrap hero">
    <div class="hero-id">
      {/* 写真は 2026-10-12 に本人から受け取った物。胸の社名ロゴが入らない位置で切り抜き、メタデータを消して書き出した */}
      <img
        class="profile-photo"
        src="/profile-320.webp"
        srcset="/profile-320.webp 1x, /profile-640.webp 2x"
        width="96"
        height="96"
        alt={氏名}
        decoding="async"
      />
      <div>
        <p class="section-label">営業・プランナー</p>
        <h1>{氏名}</h1>
      </div>
    </div>
    <p class="hero-copy">
      <span class="phrase">営業とプランニングで、</span><span class="phrase">売れる形をつくる。</span><br />
      <span class="phrase">AI も自分で作って、</span><span class="phrase">毎日の仕事に使っている。</span>
    </p>
    <p class="sub">
      求人広告の法人営業、インフルエンサー施策の営業を経て、いまは株式会社REECH（クロス・マーケティンググループ）で SNS アカウントプランナーをしています（2026年10月時点）。
    </p>
    <nav class="hero-toc" aria-label="このページの目次">
      <a href="#実績">実績</a>
      <a href="#経歴">経歴</a>
      <a href="#できること">今できること</a>
      <a href="#AI">AI で作っているもの</a>
    </nav>
  </section>

  {/* ── 2 実績（数字4つ＋就任） ─────────────── */}
  <section class="wrap section section--wide" id="実績">
    <p class="section-label">実績</p>
    <h2>数字で見る、これまでの仕事</h2>
    <ul class="proof">
      {実績の数字.map((n) => (
        <li>
          <b>{n.数字}</b>
          <span class="proof-what">{n.説明}</span>
          <small>{n.時点}</small>
        </li>
      ))}
    </ul>
    <p class="faint proof-note">
      はじめの3つは、求人広告の法人営業で 2024年3月時点の職務経歴書に書いた「直近1年」の実績です。<br />
      {就任}。
    </p>
  </section>

  {/* ── 3 経歴 ───────────────────────────── */}
  <section class="wrap section" id="経歴">
    <p class="section-label">経歴</p>
    <h2>営業から、プランナーへ</h2>

    <ol class="career">
      {経歴.map((c) => (
        <li>
          <p class="career-when">{c.時期}</p>
          <div>
            <h3>
              {c.会社URL ? <a href={c.会社URL} rel="noopener" target="_blank">{c.会社名}</a> : c.会社名}{c.見出し}
            </h3>
            {c.本文 && c.本文.map((t) => <p>{t}</p>)}
            {c.数字 && (
              <ul class="career-nums">
                {c.数字.map((n) => <li>{n}</li>)}
              </ul>
            )}
            {c.数字の注記 && <p class="faint">{c.数字の注記}</p>}
            {c.小節 && (
              <div class="career-sub">
                <h4>{c.小節.見出し}</h4>
                {c.小節.本文 && <p>{c.小節.本文}</p>}
                <ul>
                  {c.小節.箇条.map((x) => <li>{x}</li>)}
                </ul>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  {/* ── 4 今できること ─────────────────────── */}
  <section class="wrap section" id="できること">
    <p class="section-label">今できること</p>
    <h2>いま、できること</h2>
    <ol class="cans">
      {今できること.map((t) => (
        <li>
          <h3>{t.名前}</h3>
          <p>{t.説明}</p>
          <p class="cans-basis">{t.裏付け}</p>
        </li>
      ))}
    </ol>
  </section>

  {/* ── 5 AI は自分で作っている（裏付け） ─────────── */}
  <section class="wrap section" id="AI">
    <p class="section-label">AI は自分で作っている</p>
    <h2>売る人が道具を作ると、売れる仕組みになる</h2>
    <p class="lead">
      何を作り、何を人の確認に残すかを、売る側の感覚で決めています。コードは AI エージェントが書き、何を作らないかと、出てきた物が事実どおりかの確認は自分でやっています。ここにあるのは個人で作って動かしている物で、受託の実績ではありません。
    </p>
    <ul class="made">
      <li>
        <p class="made-num">{アプリ数}本</p>
        <h3>App Store に公開した iOS アプリ</h3>
        <p>企画から審査の提出、公開後の更新まで1人で通しました。</p>
      </li>
      <li>
        <p class="made-num">毎朝 {毎朝のジョブ.数字}</p>
        <h3>個人で毎朝動かしている仕組み</h3>
        <p>{毎朝のジョブ.本文}（{実例の時点} 時点）</p>
      </li>
      {開発中 && (
        <li>
          <p class="made-num">要件定義中</p>
          <h3>{開発中.名前}</h3>
          <p>{開発中.副題}</p>
        </li>
      )}
    </ul>
  </section>

  {/* ── 6 つくったもの への導線 ─────────────── */}
  <section class="wrap section section--tight" id="つくったもの">
    <p class="section-label">つくったもの</p>
    <p>
      アプリ・情報サイト・業務アプリなど、企画から公開まで1人でやった物を、時点つきの数字と一緒にまとめています。
    </p>
    <div class="btn-row">
      <a class="btn btn-sub" href="/works/" data-ga="works_click" data-item="from-top">
        つくったもの（公開{公開済み一覧.length}本・開発中{開発中一覧.length}本）を見る
      </a>
    </div>
  </section>

  {/* ── 7 連絡先（一番下だけ） ─────────────── */}
  <section class="wrap section section--tight" id="連絡先">
    <p class="section-label">連絡先</p>
    <ul class="contact">
      <li>X: <a href={Xリンク} rel="me noopener" target="_blank" data-ga="cta_click" data-item="contact">{ハンドル}</a>（DM）</li>
      <li>メール: <a class="mail" href={メールリンク} data-ga="cta_click" data-item="mail-contact">{メール}</a></li>
    </ul>
  </section>
</Base>
