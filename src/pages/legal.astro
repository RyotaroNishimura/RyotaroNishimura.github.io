---
/**
 * 運営者情報。
 * 2026-10-13 オーナー回答: このサイトは「経歴を書いているだけ」で、案件を受けるためのページではない。
 * そのため受託を前提にした項目（提供するサービス・金額・お引き受けしないこと・契約と支払い・特定商取引法の表示・免責）は外し、
 * 運営者と連絡先、サイトの性格だけを残した。フッターと 404 からリンクしているのでページ自体は残す。
 */
import Base from '../layouts/Base.astro';
import { 氏名, ハンドル, Xリンク, 所在地の扱い, メール, メールリンク } from '../config/サイト設定';
---

<Base
  title="運営者情報"
  description={`${氏名}が、自分の経歴とつくったものをまとめている個人のサイトです。運営者と連絡先を記載しています。`}
>
  <div class="wrap doc">
    <p class="crumb"><a href="/">トップ</a> ／ 運営者情報</p>
    <h1>運営者情報</h1>
    <p class="meta">最終更新: 2026-10-13</p>

    <h2>運営者</h2>
    <dl>
      <dt><b>氏名</b></dt>
      <dd>{氏名}</dd>
      <dt><b>所在地</b></dt>
      <dd>{所在地の扱い}</dd>
      <dt><b>連絡先</b></dt>
      <dd>
        X（{ハンドル}）の DM、またはメール（<a class="mail" href={メールリンク}>{メール}</a>）
      </dd>
      <dt><b>X</b></dt>
      <dd><a href={Xリンク} rel="me noopener" target="_blank">{ハンドル}</a>（{氏名}本人が運用しています）</dd>
    </dl>

    <h2>このサイトについて</h2>
    <p>
      {氏名}の経歴と、個人でつくったものをまとめたサイトです。サイト上で商品やサービスの販売・申し込み・決済は行っていません。
    </p>
    <p>
      数字には時点を添え、一次ソースで確かめたものだけを載せています。勤務先のクライアントの社名・案件名は載せていません。
    </p>

    <a class="back-link" href="/">← トップに戻る</a>
  </div>
</Base>
